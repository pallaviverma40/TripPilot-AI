{
  "name": "trippilot-ai",
  "version": "1.0.0",
  "private": true,
  "description": "TripPilot AI - Multi-Agent AI Travel Planner",
  "scripts": {
    "start": "python -m uvicorn app.main:app --app-dir backend --host 0.0.0.0 --port ${PORT:-8000}",
    "start:backend": "cd backend && python -m uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8000}",
    "build": "pip install -r requirements.txt",
    "build:backend": "pip install -r backend/requirements.txt",
    "frontend:dev": "cd frontend && npm run dev",
    "frontend:build": "cd frontend && npm run build",
    "frontend:preview": "cd frontend && npm run preview"
  },
  "keywords": [
    "travel-planner",
    "ai-agents",
    "fastapi",
    "react"
  ],
  "author": "TripPilot Team",
  "license": "MIT"
}

