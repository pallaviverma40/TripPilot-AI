# ============================================================
# TripPilot AI — Environment Variables Template
# ============================================================
# HOW TO USE:
# 1. Copy this file: copy .env.example .env
# 2. Fill in your actual values in .env
# 3. NEVER commit .env to Git
# ============================================================

# ---- Backend Server ----
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
DEBUG=True

# ---- Database (PostgreSQL) ----
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/trippilot_db
DB_USER=postgres
DB_PASSWORD=your_password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=trippilot_db

# ---- AI / LLM ----
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_MODEL=gpt-4o-mini

# ---- Google Gemini (Alternative LLM) ----
GOOGLE_API_KEY=your-google-api-key-here

# ---- JWT Authentication ----
SECRET_KEY=your-super-secret-jwt-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ---- Travel APIs ----
# Amadeus (Flights)
AMADEUS_CLIENT_ID=your-amadeus-client-id
AMADEUS_CLIENT_SECRET=your-amadeus-client-secret
AMADEUS_API_URL=https://test.api.amadeus.com

# OpenWeatherMap (Weather)
OPENWEATHER_API_KEY=your-openweathermap-key

# RapidAPI (Hotels / Buses)
RAPIDAPI_KEY=your-rapidapi-key

# Google Maps (Map View)
GOOGLE_MAPS_API_KEY=your-google-maps-key

# ---- Frontend ----
VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-key

# ---- CORS ----
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

